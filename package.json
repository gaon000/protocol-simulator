{
  "name": "protocol-simulator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=24.18.0 <25",
    "pnpm": ">=9.15.0 <10"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "biome lint .",
    "format:check": "biome format .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/unit/*.test.ts tests/integration/*.test.ts",
    "test:e2e": "pnpm build && playwright test",
    "test:performance": "pnpm build && playwright test --config=playwright.performance.config.ts",
    "check:docs": "node scripts/check-docs.ts",
    "build": "pnpm typecheck && vite build",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm check:docs && pnpm test:e2e && pnpm test:performance"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@playwright/test": "1.64.1",
    "@types/mdast": "4.0.4",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "github-slugger": "2.0.0",
    "mdast-util-to-string": "4.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "typescript": "7.0.2",
    "unified": "11.0.5",
    "vite": "8.3.5"
  }
}
